{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "second-brain-mcp",
  "account_id": "337de6b8e4de301a53ecae0c06afcc72",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Every resource below is created by scripts/setup.sh; secrets by scripts/secrets.sh.
  // Notes still live on GitHub (YudiG12/segundo-cerebro) until they move to Artifacts (ADR 007).
  // Secrets: MCP_TOKEN, GITHUB_TOKEN, WEBHOOK_SECRET.
  "ai": { "binding": "AI" },
  // semantic index: 1024 dimensions (bge-m3), cosine
  "vectorize": [{ "binding": "VECTORS", "index_name": "second-brain" }],
  "observability": { "enabled": true }
}
