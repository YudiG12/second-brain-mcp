{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "second-brain-mcp",
  "account_id": "337de6b8e4de301a53ecae0c06afcc72",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Every resource below is created by scripts/setup.sh; secrets by scripts/secrets.sh.
  // Notes live in Cloudflare Artifacts (ADR 007); writes go through the RepoWriter Durable Object (ADR 008).
  // Secrets: MCP_TOKEN, ADMIN_SECRET. Pushes to the notes repo reach index-jobs through an event
  // subscription created by scripts/setup.sh (Artifacts `pushed` events).
  "ai": { "binding": "AI" },
  // semantic index: 1024 dimensions (bge-m3), cosine
  "vectorize": [{ "binding": "VECTORS", "index_name": "second-brain" }],
  // invocation logs would record request URLs, which carry MCP_TOKEN until OAuth (ADR 004, ADR 011)
  // the Artifacts repository that holds the notes; a staging deploy points at a scratch repo
  "vars": { "NOTES_REPO": "notes", "VECTORIZE_INDEX": "second-brain", "CF_ACCOUNT_ID": "337de6b8e4de301a53ecae0c06afcc72" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "second-brain" }],
  "durable_objects": { "bindings": [{ "name": "WRITER", "class_name": "RepoWriter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoWriter"] }],
  // index manifest and alerts (ADR 010); schema in migrations/
  "d1_databases": [{ "binding": "DB", "database_name": "second-brain", "database_id": "cf1f9133-d4cb-4836-b90a-1fcfee05d836", "migrations_dir": "migrations" }],
  // indexing (ADR 009): the consumer is the only index writer, one message at a time
  "queues": {
    "producers": [{ "binding": "INDEX_JOBS", "queue": "index-jobs" }],
    "consumers": [
      { "queue": "index-jobs", "max_batch_size": 10, "max_concurrency": 1, "max_retries": 5, "dead_letter_queue": "index-jobs-dlq" },
      { "queue": "index-jobs-dlq", "max_batch_size": 10, "max_concurrency": 1, "max_retries": 3 }
    ]
  },
  // reconciliation (ADR 009): daily at 04:00 UTC, or on demand through /admin/reconcile
  "workflows": [{ "name": "reconcile", "binding": "RECONCILE", "class_name": "Reconcile", "schedules": ["0 4 * * *"] }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
