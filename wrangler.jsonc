{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerebro-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // notes live on GitHub (YudiG12/segundo-cerebro); secrets: GITHUB_TOKEN, WEBHOOK_SECRET, MCP_TOKEN
  // multilingual embedding model (the notes are written in Portuguese)
  "ai": { "binding": "AI" },
  // semantic search index: 1024 dimensions, cosine. Paths are relative to the repo root.
  "vectorize": [{ "binding": "VECTORS", "index_name": "segundo-cerebro" }]
}
